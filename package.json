{
  "name": "herbify-debug-mcp",
  "version": "1.0.0",
  "description": "MCP server for debugging the Herbify plant-identification repo (ONNX model, Vercel, Git LFS, image upload)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "herbify-debug-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
